# BuildVision AI works with NO environment variables (no login, projects stay in the browser).
# To switch on accounts, email verification, the admin Settings panel and cloud saving, set these in
# Vercel -> Project -> Settings -> Environment Variables. Never put real values in this file.
# Full step-by-step guide: ACCOUNTS_SETUP.md

# Neon connection string (Neon dashboard -> Connect -> copy the "pooled" string). REQUIRED to turn accounts on.
DATABASE_URL=

# Any long random text (40+ characters). Encrypts the mail key stored in the database. REQUIRED with DATABASE_URL.
APP_SECRET=

# Your own email address: the account registered with it becomes the admin.
ADMIN_EMAIL=

# Only for the very first start, so the admin can receive the first verification code.
# After you paste the key in Settings -> Email you may delete these two.
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), SMTP_FROM_NAME

# Optional: AI mode keys can also be pasted in Settings > AI mode instead
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: public address of your site (used so the logo can appear in emails). Vercel sets this automatically for production.
# APP_URL=https://your-site.vercel.app
